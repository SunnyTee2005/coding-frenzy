{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPE 模擬考場",
  "mainBinaryName": "cpe-sim",
  "version": "0.1.0",
  "identifier": "io.github.sunnytee2005.cpe-sim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CPE 模擬考場（非官方）",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Education",
    "shortDescription": "CPE 大學程式能力檢定模擬考試環境（非官方）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../problems/": "problems/",
      "../../crates/judge/shim/": "shim/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
